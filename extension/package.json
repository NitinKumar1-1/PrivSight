{
  "name": "privsight-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "eval": "vitest run --config vitest.evaluation.config.ts",
    "test:chrome": "vitest run --config vitest.chrome.config.ts",
    "eval:render": "node evaluation/scripts/render-fixtures.mjs",
    "eval:legacy": "vitest run --config vitest.eval.config.ts",
    "benchmark": "vitest run --config vitest.benchmark.config.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/pngjs": "^6.0.5",
    "jsdom": "^25.0.0",
    "playwright": "1.63",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
