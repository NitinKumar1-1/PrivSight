# Copy to backend/.env and fill in. Never commit backend/.env.
# Start the server with:  python -m uvicorn app.main:app --port 8000 --reload --env-file .env

# Reasoning provider: "gemini" (default) or "stub" (offline, returns the Phase 1 action)
LLM_PROVIDER=gemini

# Gemini API key. Server-side only. Never place it in the extension.
GEMINI_API_KEY=API_KEY_HERE

# Primary model. Change if your account's free tier offers a different model.
GEMINI_MODEL=gemini-3.6-flash

# Tried in order if the primary model is retired (404) or overloaded (503).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-latest

# Upstream request timeout in seconds (per attempt)
LLM_TIMEOUT_SECONDS=30

# Optional: Gemini thinking budget in tokens. Leave unset for the provider default.
# 0 skips the model's reasoning phase (lower latency; measured in Phase 5).
# GEMINI_THINKING_BUDGET=0

# Set to 1 to print the exact prompt sent to Gemini and its raw reply in the
# backend terminal. The prompt is built only from the sanitized request, so it
# is safe to show. The API key is never printed.
LLM_DEBUG=0
